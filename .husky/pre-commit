#!/usr/bin/env sh
set -eu
pnpm_config_verify_deps_before_run=false pnpm run lint:lint-staged

# Check the index after lint-staged fixes it. Unstaged edits must not mask errors.
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/sunrise-web-index.XXXXXXXX")
trap 'rm -rf -- "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM
git checkout-index --all --prefix="$snapshot/"
ln -s "$(pwd -P)/node_modules" "$snapshot/node_modules"
cd "$snapshot"
node scripts/type-check.mjs
