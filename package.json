{
  "name": "sunrise-travel-ops-web",
  "description": "Sunrise TravelOps Web Application",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts,js}\"",
    "lint:fix": "eslint --cache \"src/**/*.{vue,ts,js}\" --fix",
    "lint:lint-staged": "lint-staged",
    "lint": "pnpm run lint:eslint",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "git-cz",
    "deploy": "node deploy.mjs"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": "eslint --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.4.0",
    "animate.css": "^4.1.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.4.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify/utils": "^3.1.4",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": "https://gitee.com/youlaiorg/vue3-element-admin.git",
  "author": "有来开源组织",
  "license": "MIT"
}
